<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.ParqueDeEstacionamento" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/primary_dark</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/primary_dark</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Ripple -->
        <item name="android:colorControlHighlight">@color/ripple</item>
    </style>

    <style name="Theme.ParqueDeEstacionamento" parent="Base.Theme.ParqueDeEstacionamento" />

    <!-- Splash screen theme -->
    <style name="Theme.ParqueDeEstacionamento.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logoclaro</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/primary_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.ParqueDeEstacionamento</item>
    </style>

    <!-- Main activity theme -->
    <style name="Theme.ParqueDeEstacionamento.Main" parent="Base.Theme.ParqueDeEstacionamento">
        <item name="android:colorBackground">@color/primary</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.Parking.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <style name="Widget.Parking.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <!-- Input Styles -->
    <style name="Widget.Parking.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.Parking" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Parking.Headline" parent="TextAppearance.Parking">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Parking.Title" parent="TextAppearance.Parking">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Parking.Body" parent="TextAppearance.Parking">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Parking.Caption" parent="TextAppearance.Parking">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.Parking.BottomNav.ActiveIndicator" parent="">
        <item name="android:color">@color/surface_elevated</item>
    </style>

</resources>